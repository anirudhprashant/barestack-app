# BareStack CRM Environment Configuration
# Copy this file to .env and customize for your environment

# PocketBase URL
# Self-hosted (default): your own local PocketBase on this machine
# Hosted BareStack cloud: https://api.barestack.org
VITE_POCKETBASE_URL=http://127.0.0.1:8092

# Demo mode (optional, leave unset for normal installs).
# If both are set, the app signs in automatically with this account on
# load, so a public demo opens straight into the dashboard. Only ever
# point these at a disposable seeded account.
# VITE_DEMO_EMAIL=demo@example.com
# VITE_DEMO_PASSWORD=changeme
